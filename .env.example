# Les deux plateformes ont des bases API distinctes (HTTPS en production).
# Ces variables doivent être présentes dans l'environnement du serveur d'actions
# (rasa run actions ne charge pas de fichier .env automatiquement).
CHATBOT_ECARRIERE_BASE_URL=https://ecarriere-api.exemple.sn/api/chatbot
CHATBOT_PGDE_BASE_URL=https://pgde.exemple.sn/api/v1/chatbot
CHATBOT_BACKEND_TIMEOUT=15

# Authentification : à définir séparément avec chaque équipe backend.
# CHATBOT_PGDE_TOKEN doit être identique à CHATBOT_API_TOKEN du projet Laravel emplois.
# Ne jamais committer les vrais jetons.
CHATBOT_ECARRIERE_TOKEN=
CHATBOT_PGDE_TOKEN=

# E-Carrière : chemins proposés, à remplacer par les URLs finales du backend.
CHATBOT_ECARRIERE_VERIFY_ENDPOINT=/ecarriere/agents/verify
CHATBOT_ECARRIERE_ACTES_ENDPOINT=/ecarriere/agents/actes
CHATBOT_ECARRIERE_PROJETS_ENDPOINT=/ecarriere/agents/projets
CHATBOT_ECARRIERE_RESET_ENDPOINT=/ecarriere/password/reset

# PGDE : chemins réels exposés par emplois (routes/api.php, groupe api/v1/chatbot/pgde).
CHATBOT_PGDE_VERIFY_ENDPOINT=/pgde/accounts/verify
CHATBOT_PGDE_RESET_ENDPOINT=/pgde/password/reset
