# Les deux plateformes ont des bases API distinctes (HTTPS en production).
# Ces variables doivent être présentes dans l'environnement du serveur d'actions
# (rasa run actions ne charge pas de fichier .env automatiquement).
CHATBOT_ECARRIERE_BASE_URL=https://ecarriere-api.exemple.sn/api/chatbot
CHATBOT_PGDE_BASE_URL=https://pgde.exemple.sn/api/v1/chatbot
CHATBOT_BACKEND_TIMEOUT=15

# Nombre de processus du serveur d'actions (Linux). Les actions sont synchrones :
# avec 1 seul processus, un appel lent (API PGDE, SQL Server) bloque tous les utilisateurs.
# Serveur Linux uniquement : ne pas définir en local sous Windows.
ACTION_SERVER_SANIC_WORKERS=4

# Authentification : à définir séparément avec chaque équipe backend.
# CHATBOT_PGDE_TOKEN doit être identique à CHATBOT_API_TOKEN du projet Laravel emplois.
# Ne jamais committer les vrais jetons.
CHATBOT_ECARRIERE_TOKEN=
CHATBOT_PGDE_TOKEN=

# E-Carrière : source des données.
#   legacy (défaut) = lecture directe SQL Server, tant que l'API E-Carrière n'existe pas
#   api             = client HTTP (variables CHATBOT_ECARRIERE_* ci-dessus et ci-dessous)
CHATBOT_ECARRIERE_MODE=legacy

# Mode legacy uniquement : accès SQL Server E-Carrière (ne jamais committer les vraies valeurs).
LEGACY_ECARRIERE_DB_HOST=
LEGACY_ECARRIERE_DB_PORT=1433
LEGACY_ECARRIERE_DB_NAME=referentiel_fudpe_new
LEGACY_ECARRIERE_DB_USER=
LEGACY_ECARRIERE_DB_PASSWORD=
# Service officiel de réinitialisation ({email} est remplacé automatiquement)
LEGACY_ECARRIERE_RESET_URL=https://e-carriere.sec.gouv.sn/account-management-fudpe/users/{email}/reset-password-forgot

# E-Carrière mode api : chemins proposés, à remplacer par les URLs finales du backend.
CHATBOT_ECARRIERE_VERIFY_ENDPOINT=/ecarriere/agents/verify
CHATBOT_ECARRIERE_ACTES_ENDPOINT=/ecarriere/agents/actes
CHATBOT_ECARRIERE_PROJETS_ENDPOINT=/ecarriere/agents/projets
CHATBOT_ECARRIERE_RESET_ENDPOINT=/ecarriere/password/reset

# PGDE : chemins réels exposés par emplois (routes/api.php, groupe api/v1/chatbot/pgde).
CHATBOT_PGDE_VERIFY_ENDPOINT=/pgde/accounts/verify
CHATBOT_PGDE_RESET_ENDPOINT=/pgde/password/reset
